# Track all files in attachments with Git LFS
attachments/** filter=lfs diff=lfs merge=lfs -text

# Except for Publications folder - keep as regular Git objects
attachments/Publications/** -filter -diff -merge -text
attachments/SmallFiles/** -filter -diff -merge -text

# Jupyter notebooks and their extracted output images (may contain embedded
# base64 image blobs / rendered plots) - keep out of regular git delta history
pages/**/*.ipynb filter=lfs diff=lfs merge=lfs -text
pages/**/*_nbconvert_artifacts/** filter=lfs diff=lfs merge=lfs -text

